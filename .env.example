APP_NAME=Safara
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=safara
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync runs jobs instantly (fine locally). In production use database + `php artisan queue:work`.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Safara -------------------------------------------------------------
SAFARA_BRAND="Safara Travel"
SAFARA_TIMEZONE=Africa/Lagos
# Drivers: "fake" runs everything locally. Switch one at a time as you add keys.
SAFARA_WHATSAPP_DRIVER=fake
SAFARA_PASSPORT_DRIVER=fake
SAFARA_TRIP_PARSER=rules
SAFARA_FLIGHTS_DRIVER=fake
SAFARA_PAYMENTS_DRIVER=fake
SAFARA_SIMULATOR=true
# Operator WhatsApp number for alerts, international format without +
SAFARA_OPERATOR_PHONE=
# First desk login (php artisan db:seed or php artisan safara:operator)
SAFARA_ADMIN_NAME=Ahmad
SAFARA_ADMIN_EMAIL=admin@example.com
SAFARA_ADMIN_PASSWORD=change-me

# WhatsApp Cloud API (Meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_BUSINESS_NUMBER=
META_GRAPH_VERSION=v21.0

# OpenRouter (passport reading and trip understanding). Free models work but are
# rate-limited and weaker; see config/safara.php. Comma-separated, best first.
OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODELS=google/gemma-3-27b-it:free,qwen/qwen2.5-vl-72b-instruct:free
# OPENROUTER_TEXT_MODELS=deepseek/deepseek-v4-flash-0731,deepseek/deepseek-v4-flash,meta-llama/llama-3.3-70b-instruct:free

# Duffel
DUFFEL_ACCESS_TOKEN=
DUFFEL_CONTACT_EMAIL=
